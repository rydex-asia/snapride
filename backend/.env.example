NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Supabase transaction/session pooler URL used by the running API.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct database URL used only by Prisma migrations. If Render cannot reach the
# IPv6 direct endpoint, use Supavisor session mode (port 5432) here.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379

# Backend-only Supabase settings. Never put SERVICE_ROLE_KEY in EXPO_PUBLIC_*.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key

CORS_ORIGINS=http://localhost:8081,http://localhost:8083,http://localhost:3000

# Payments
# Use mock only for local UI development. Set razorpay in staging/production.
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server-only Google Routes key. Never expose this through EXPO_PUBLIC_*.
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_CACHE_TTL_SECONDS=45
GOOGLE_ROUTES_TIMEOUT_MS=7000
GOOGLE_ROUTES_MAX_RETRIES=3
GOOGLE_ROUTES_DAILY_QUOTA=10000
LOCATION_RAW_RETENTION_HOURS=24

# Crash reporting and performance monitoring.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Configure this public endpoint in the Razorpay Dashboard:
# https://your-api.example.com/api/v1/payments/webhooks/razorpay
