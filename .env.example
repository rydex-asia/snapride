# Set this to the backend URL reachable from the phone or production app.
# The /api/v1 suffix is added automatically when omitted.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:4000

# Optional: use a different Socket.IO origin from the REST API.
# EXPO_PUBLIC_RIDE_SOCKET_URL=http://192.168.1.100:4000
EXPO_PUBLIC_EAS_PROJECT_ID=0fcfce7e-1628-4198-b3f7-e064c014aa98

# Native Maps SDK keys are injected by EAS and restricted to the Android
# package/signing certificates or iOS bundle ID. They are never EXPO_PUBLIC_*.
GOOGLE_MAPS_ANDROID_SDK_KEY=
GOOGLE_MAPS_IOS_SDK_KEY=

# Development-only explicit opt-ins. Both remain disabled in production.
EXPO_PUBLIC_ENABLE_TRACKING_SIMULATION=false
EXPO_PUBLIC_ENABLE_ROUTE_PREVIEW=false

# Ride-first release: keep false to hide Grocery from the Home mode selector.
# Change to true when the Grocery experience is ready to launch.
EXPO_PUBLIC_GROCERY_ENABLED=false

# Mobile crash reporting. The DSN is safe to embed in the app; the auth token is not.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.15

# EAS build-only Sentry values. Store SENTRY_AUTH_TOKEN with sensitive visibility.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
